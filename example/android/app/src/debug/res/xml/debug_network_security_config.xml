<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The tester must install their Charles CA in Android's user certificate store.
         System trust remains in place. This file and its manifest entry are debug-only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
