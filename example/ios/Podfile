platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Fix Issue (b) — static/dynamic hybrid linking setup
#
# Google-Mobile-Ads-SDK ships as a static XCFramework, so the whole target must
# link statically.  However BridSDK (vendored inside AudienzziOSSDK) is a dynamic
# XCFramework that expects PrebidMobile and Protobuf as dynamic frameworks at
# runtime, so we override those two pods back to dynamic in pre_install.
pre_install do |installer|
  dynamic_pods = %w[PrebidMobile Protobuf]
  installer.pod_targets.each do |pod|
    next unless dynamic_pods.include?(pod.name)
    def pod.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end

target 'Runner' do
  # Required because Google-Mobile-Ads-SDK is a static XCFramework.
  # PrebidMobile and Protobuf are forced back to dynamic in pre_install above.
  use_frameworks! :linkage => :static

  # Pin AudienzziOSSDK to the exact release tag so CocoaPods fetches it
  # directly from GitHub without requiring a trunk registry push.
  # Remove this override once 0.4.0 is published to the CocoaPods trunk.
  # ── Local native testing ───────────────────────────────────────────────────
  # This bridge calls native APIs that are NOT in any published release, so running the example
  # needs the iOS SDK checkout. Point at it with:
  #
  #   export AUDIENZZ_IOS_SDK_PATH=~/Documents/audienzz-ios-sdk
  #   pod install
  #
  # ...and `unset` it + `pod install` again to go back to the published tag. Kept as an env var
  # rather than an edit so the committed Podfile and Podfile.lock keep naming a real release —
  # a checked-in absolute path only resolves on one machine. See LOCAL_TESTING.md.
  audienzz_local_ios_sdk = ENV['AUDIENZZ_IOS_SDK_PATH']
  if audienzz_local_ios_sdk && !audienzz_local_ios_sdk.empty?
    Pod::UI.puts "[Audienzz] using LOCAL iOS SDK at #{audienzz_local_ios_sdk}".yellow
    pod 'AudienzziOSSDK', :path => audienzz_local_ios_sdk
  else
    pod 'AudienzziOSSDK', :git => 'https://github.com/audienzz/audienzz-ios-sdk.git', :tag => '0.4.0'
  end

  # AudienzziOSSDK 0.4.0 builds against STOCK PrebidMobile (no fork). Pin 3.3.1+
  # for the UserUniqueID(uniqueId:) API the SDK uses.
  # NOTE: after changing these pins always `flutter clean` — a stale
  # PrebidMobile-Swift.h in build/ otherwise causes a spurious
  # "PBMOpenMeasurementFriendlyObstructionPurpose redefinition".
  pod 'PrebidMobile',                 '~> 3.3.1'
  pod 'PrebidMobileGAMEventHandlers', '~> 3.3.1'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
