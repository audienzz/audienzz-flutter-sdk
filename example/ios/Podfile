platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Fix Issue (b) — static/dynamic hybrid linking setup
#
# Google-Mobile-Ads-SDK ships as a static XCFramework, so the whole target must
# link statically.  However BridSDK (vendored inside AudienzziOSSDK) is a dynamic
# XCFramework that expects PrebidMobile and Protobuf as dynamic frameworks at
# runtime, so we override those two pods back to dynamic in pre_install.
pre_install do |installer|
  dynamic_pods = %w[PrebidMobile Protobuf]
  installer.pod_targets.each do |pod|
    next unless dynamic_pods.include?(pod.name)
    def pod.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end

target 'Runner' do
  # Required because Google-Mobile-Ads-SDK is a static XCFramework.
  # PrebidMobile and Protobuf are forced back to dynamic in pre_install above.
  use_frameworks! :linkage => :static

  # Pin AudienzziOSSDK to the exact release tag so CocoaPods fetches it
  # directly from GitHub without requiring a trunk registry push.
  # Remove this override once 0.2.4 is published to the CocoaPods trunk.
  pod 'AudienzziOSSDK', :git => 'https://github.com/audienzz/audienzz-ios-sdk.git', :tag => '0.2.4'

  # PrebidMobile 3.3.1+ is required: AudienzziOSSDK 0.2.4 uses the
  # UserUniqueID(uniqueId:) initializer introduced in 3.3.1.
  # NOTE: an earlier "PBMOpenMeasurementFriendlyObstructionPurpose redefinition"
  # failure that made 3.1+ look incompatible was NOT a real PrebidMobile bug —
  # it was a stale header left in Flutter's build/ dir after switching pod
  # versions.  Always `flutter clean` after changing these pins.
  pod 'PrebidMobile',                 '~> 3.3.1'
  pod 'PrebidMobileGAMEventHandlers', '~> 3.3.1'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
